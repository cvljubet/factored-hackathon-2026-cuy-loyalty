# Copy values into a local .env file and replace placeholders as needed.
# Do not put real credentials in this example file.
APP_ENV=development
SOURCE_URI=s3://factored-datathon-2026-s3-157725502942-us-east-2-an/data
LAKE_BUCKET=<bucket-name>
SOURCE_PROFILE=factored
TARGET_PROFILE=<target-profile>

# Backend Cognito JWT validation; fill in from Terraform:
#   terraform -chdir=infrastructure/terraform/envs/dev output
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Agent tool data (optional). memory = synthetic profiles only; dynamodb = the customer-serving
# table in the team account, through its own profile (never the Bedrock one).
# SERVING_BACKEND=dynamodb
# SERVING_TABLE_NAME=cuy-loyalty-dev-customer-serving
# SERVING_AWS_REGION=us-east-2
# SERVING_AWS_PROFILE=cuy-loyalty

# Chat agent (optional). local/rules need no AWS access. For Bedrock, use an AWS
# profile or the task role; never put access keys here.
# AGENT_LLM=bedrock
# AGENT_ROUTER=bedrock
# BEDROCK_REGION=us-east-2
# BEDROCK_PROFILE=
# BEDROCK_INQUIRY_FALLBACK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=
